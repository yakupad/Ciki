      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecikti"
          }
        }
      }
    },
    "Gelir + alacak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income + receivables"
