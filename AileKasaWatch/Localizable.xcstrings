    "iPhone'da Aile Kasası'nı açın": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Aile Kasası on iPhone"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da Aile Kasası'nı açın"
          }
        }
      }
    },
    "iPhone'da uygulama kilidi açık olduğu için saatte tutar gösterilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts aren't shown on the watch because the app lock is on on your iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'da uygulama kilidi açık olduğu için saatte tutar gösterilmez."
          }
        }
      }
    },
    "İşaret iPhone'a gönderilir. iPhone yakında değilse bağlanınca iletilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is sent to your iPhone. If it isn't nearby, it's delivered when it reconnects."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaret iPhone'a gönderilir. iPhone yakında değilse bağlanınca iletilir."
          }
        }
      }
    },
    "Tutarlar gizli": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts hidden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
