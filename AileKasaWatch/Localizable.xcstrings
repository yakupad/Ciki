{
  "sourceLanguage": "tr",
  "strings": {
    "Ay sonu net": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Net at month end"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ay sonu net"
          }
        }
      }
    },
    "Bu ay bekleyen ödeme yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No payments due this month"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay bekleyen ödeme yok"
          }
        }
      }
    },
