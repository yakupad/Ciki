    "Son ödeme günü girilmiş ve ödenmemiş giderler için bildirim gelir. Ödendi işaretlenen kayıtların bildirimi iptal olur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a notification for unpaid expenses that have a due day. Marking an entry as paid cancels its reminder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ödeme günü girilmiş ve ödenmemiş giderler için bildirim gelir. Ödendi işaretlenen kayıtların bildirimi iptal olur."
          }
        }
      }
    },
    "Son ödeme gününden bir gün önce saat 09:00'da bildirim gelir. Zamanı Ayarlar'dan değiştirebilirsiniz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be notified at 9:00 the day before a payment is due. You can change the time in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ödeme gününden bir gün önce saat 09:00'da bildirim gelir. Zamanı Ayarlar'dan değiştirebilirsiniz."
          }
        }
      }
    },
