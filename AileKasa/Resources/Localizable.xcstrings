    },
    "Sistem seçiliyse telefonun açık ya da koyu mod ayarı izlenir. Bu ayar yalnızca bu telefon için geçerlidir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With System, the app follows your phone's light or dark mode. This setting applies to this phone only."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem seçiliyse telefonun açık ya da koyu mod ayarı izlenir. Bu ayar yalnızca bu telefon için geçerlidir."
          }
        }
      }
    },
    "Sola kaydırın: ödendi. Sağa kaydırın: bu ay hesaba katma. Düzenli kalemler kayıt girilene kadar tahmini görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe left: paid. Swipe right: skip this month. Recurring items show as estimates until you enter an amount."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola kaydırın: ödendi. Sağa kaydırın: bu ay hesaba katma. Düzenli kalemler kayıt girilene kadar tahmini görünür."
          }
        }
      }
    },
