          "stringUnit": {
            "state": "translated",
            "value": "Keep your own accounts and the IBANs of people and companies you pay here. Tap an account to copy its IBAN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi hesaplarınızı ve ödeme yaptığınız kişi ve kurumların IBAN'larını burada saklayın. Bir hesaba dokununca IBAN kopyalanır."
          }
        }
      }
    },
