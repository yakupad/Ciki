    "Silme işlemi bu cihazdaki ve iCloud'unuzdaki kalemleri, kayıtları, kişileri ve hesapları kaldırır. Geri alınamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes items, entries, people and accounts from this device and your iCloud. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Silme işlemi bu cihazdaki ve iCloud'unuzdaki kalemleri, kayıtları, kişileri ve hesapları kaldırır. Geri alınamaz."
          }
        }
      }
    },
    "Sistem": {
