    "%lld döviz kalemi kur olmadığı için toplama girmedi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left out of totals because no exchange rate is available: %lld foreign currency item(s)."
          }
