            "state": "translated",
            "value": "iCloud"
          }
        }
      }
    },
    "iCloud açıksa aynı veriler sizin özel iCloud alanınıza eşitlenir. Eşinizle paylaşırsanız ortak hane yalnızca davet ettiğiniz kişiyle paylaşılır. Uygulamanın geliştiricisi bu verilere erişemez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iCloud is on, the same data syncs to your private iCloud space. If you share with your partner, the household is shared only with the person you invite. The app's developer can't access this data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud açıksa aynı veriler sizin özel iCloud alanınıza eşitlenir. Eşinizle paylaşırsanız ortak hane yalnızca davet ettiğiniz kişiyle paylaşılır. Uygulamanın geliştiricisi bu verilere erişemez."
          }
        }
      }
    },
