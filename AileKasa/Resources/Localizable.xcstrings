            "value": "Kişi ekle"
          }
        }
      }
    },
    "Kişi renkleri özet, liste ve tabloda kullanılır. Silinen kişinin kalemleri Ortak'a geçer. Bu telefonu kullanan kişiyi seçerseniz yaptığınız değişikliklerde adınız görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Person colors are used in the summary, lists and table. A deleted person's items move to Shared. Choose who uses this phone so your name appears on the changes you make."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi renkleri özet, liste ve tabloda kullanılır. Silinen kişinin kalemleri Ortak'a geçer. Bu telefonu kullanan kişiyi seçerseniz yaptığınız değişikliklerde adınız görünür."
