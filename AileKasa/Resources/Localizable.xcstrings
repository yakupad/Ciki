            "value": "Kayıt listesi"
          }
        }
      }
    },
    "Kayıtlar yalnızca cihazınızda ve kendi iCloud hesabınızda durur. Reklam ya da analiz yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on your device and in your own iCloud account. No ads, no analytics."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlar yalnızca cihazınızda ve kendi iCloud hesabınızda durur. Reklam ya da analiz yok."
          }
        }
      }
    },
    "Kayıtları ya da aylık tabloyu Excel, Numbers veya Google E-Tablolar'da açmak için.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To open your entries or the monthly table in Excel, Numbers or Google Sheets."
