  "strings" : {
    "%@ – %@, toplam %lld ay." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – %2$@, %3$lld months in total."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@, toplam %lld ay."
          }
        }
      }
    },
    "%@ adına %lld kalem var. Kalemler ve kayıtları silinmez, Ortak'a geçer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has %2$lld item(s). Items and their entries are kept and move to Shared."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adına %lld kalem var. Kalemler ve kayıtları silinmez, Ortak'a geçer."
