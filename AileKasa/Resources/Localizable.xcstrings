{
  "sourceLanguage": "tr",
  "strings": {
    "%@ adına %lld kalem var. Kalemler ve kayıtları silinmez, Ortak'a geçer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has %2$lld item(s). Items and their entries are kept and move to Shared."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adına %lld kalem var. Kalemler ve kayıtları silinmez, Ortak'a geçer."
          }
        }
      }
    },
    "%@ ayında kopyalanacak yeni kayıt yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new to copy from %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ayında kopyalanacak yeni kayıt yok."
          }
        }
      }
    },
    "%@ ayından itibaren her ay tahmini olarak görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown as an estimate every month from %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ayından itibaren her ay tahmini olarak görünür."
          }
        }
      }
    },
    "%@ boş": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is empty"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boş"
          }
        }
      }
    },
    "%@ için bekleyen ödeme yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pending payments for %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için bekleyen ödeme yok."
          }
        }
      }
    },
    "%@ kişisini sil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisini sil"
          }
        }
      }
    },
    "%@ kuru henüz alınamadı. Toplamlar kur gelene kadar eksik görünebilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ rate yet. Totals may be incomplete until rates load."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuru henüz alınamadı. Toplamlar kur gelene kadar eksik görünebilir."
          }
        }
      }
    },
    "%@ rehberden silinir. Bağlı kalemler silinmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be removed from your accounts. Linked items are kept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rehberden silinir. Bağlı kalemler silinmez."
          }
        }
      }
    },
    "%@ – %@, toplam %lld ay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ – %2$@, %3$lld months in total."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – %@, toplam %lld ay."
          }
        }
      }
    },
