    "Kira, aidat ya da gönderim gibi ödemelerde alıcının IBAN'ını seçin. Kayıt ekranında tek dokunuşla kopyalanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For payments like rent, building fees or transfers, choose the recipient's IBAN. You can copy it with one tap from the entry screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira, aidat ya da gönderim gibi ödemelerde alıcının IBAN'ını seçin. Kayıt ekranında tek dokunuşla kopyalanır."
          }
        }
      }
    },
    "Kira, kredi taksidi, maaş ve döviz gönderimleri gibi her ay tekrar eden kalemler için açın.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on for items that repeat every month, like rent, loan installments, salary and foreign currency transfers."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira, kredi taksidi, maaş ve döviz gönderimleri gibi her ay tekrar eden kalemler için açın."
          }
        }
      }
    },
