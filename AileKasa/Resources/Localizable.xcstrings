        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld döviz kalemi kur olmadığı için toplama girmedi."
          }
        }
      }
    },
    "%lld kayıt %@ ayından kopyalandı. Tutarları ekstreye göre güncelleyin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied %1$lld entries from %2$@. Update the amounts to match your statements."
